{
  "name": "job-scheduler-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-inspired distributed job scheduling platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/db-generate.js",
    "build": "npm run build --workspaces",
    "db:generate": "node scripts/db-generate.js",
    "db:push": "node scripts/db-push.js",
    "db:seed": "npm run db:seed --workspace=@job-scheduler/database",
    "dev:api": "npm run dev --workspace=@job-scheduler/api",
    "dev:worker": "npm run dev --workspace=@job-scheduler/worker",
    "dev:web": "npm run dev --workspace=@job-scheduler/web",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
